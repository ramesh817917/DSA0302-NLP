import re
from collections import Counter

corpus = """
The student is studying computer science.
The student is reading a book.
The student is writing a program.
The teacher is teaching computer science.
The teacher is reading a book.
The student likes computer science.
The student likes reading books.
"""

sentences = re.split(r'[.!?]', corpus.lower())

data = []

for sentence in sentences:
    words = re.findall(r'\b[a-z]+\b', sentence)

    if words:
        data.append(words)

unigram = Counter()
bigram = Counter()
trigram = Counter()

for words in data:
    unigram.update(words)

    for i in range(len(words) - 1):
        bigram[(words[i], words[i + 1])] += 1

    for i in range(len(words) - 2):
        trigram[(words[i], words[i + 1], words[i + 2])] += 1


total = sum(unigram.values())


def uni(w):
    return unigram[w] / total


def bi(w1, w2):
    if unigram[w1] == 0:
        return 0

    return bigram[(w1, w2)] / unigram[w1]


def tri(w1, w2, w3):
    if bigram[(w1, w2)] == 0:
        return 0

    return trigram[(w1, w2, w3)] / bigram[(w1, w2)]


def backoff(w1, w2, w3):
    p = tri(w1, w2, w3)

    if p > 0:
        return p

    p = bi(w2, w3)

    if p > 0:
        return p

    return uni(w3)


lambda1 = 0.2
lambda2 = 0.3
lambda3 = 0.5


def interpolation(w1, w2, w3):
    return (
        lambda1 * uni(w3)
        + lambda2 * bi(w2, w3)
        + lambda3 * tri(w1, w2, w3)
    )


query = input("Enter sentence: ").lower().split()

w1 = query[-2]
w2 = query[-1]

results = []

for word in unigram:
    unsmoothed = tri(w1, w2, word)
    back = backoff(w1, w2, word)
    interp = interpolation(w1, w2, word)

    results.append(
        (word, unsmoothed, back, interp)
    )


print("\nUnsmoothed Predictions:")

for item in sorted(
    results,
    key=lambda x: x[1],
    reverse=True
)[:5]:
    print(item[0], "->", round(item[1], 4))


print("\nBackoff Predictions:")

for item in sorted(
    results,
    key=lambda x: x[2],
    reverse=True
)[:5]:
    print(item[0], "->", round(item[2], 4))


print("\nDeleted Interpolation Predictions:")

for item in sorted(
    results,
    key=lambda x: x[3],
    reverse=True
)[:5]:
    print(item[0], "->", round(item[3], 4))
