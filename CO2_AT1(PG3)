# Stemming Based Preprocessing

words = ["played", "player", "playing"]

print("-" * 110)
print(f"{'Word':<15}{'Stem':<15}{'Removed Affix':<18}{'Type':<18}{'Normalized'}")
print("-" * 110)

for word in words:

    if word.endswith("ed"):
        stem = word[:-2]
        affix = "ed"
        t = "Inflectional"

    elif word.endswith("ing"):
        stem = word[:-3]
        affix = "ing"
        t = "Inflectional"

    elif word.endswith("er"):
        stem = word[:-2]
        affix = "er"
        t = "Derivational"

    else:
        stem = word
        affix = "-"
        t = "-"

    print(f"{word:<15}{stem:<15}{affix:<18}{t:<18}play")
