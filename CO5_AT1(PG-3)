# Step 1: Source Analysis
data = source_analysis(source)

print("\n1. SOURCE ANALYSIS")
for key, value in data.items():
    print(f"{key}: {value}")


# Step 2: Predicate Logic
logic = create_predicate_logic(data)

print("\n2. PREDICATE LOGIC REPRESENTATION")
print(logic)


# Step 3: Interlingua
interlingua = create_interlingua(data)

print("\n3. INTERLINGUA REPRESENTATION")
for key, value in interlingua.items():
    print(f"{key}: {value}")


# Step 4: Candidate Generation
candidates = generate_candidates()

print("\n4. TRANSLATION CANDIDATES")

for candidate in candidates:
    print(candidate["sentence"])


# Step 5: Statistical Selection
best = select_best_translation(candidates)

print("\n5. STATISTICAL SCORES")

for candidate in candidates:
    print(
        f"{candidate['sentence']} "
        f"--> Combined Score: {candidate['combined_score']:.3f}"
    )


print("\nFINAL TRANSLATION")
print("-" * 50)
print(best["sentence"])
