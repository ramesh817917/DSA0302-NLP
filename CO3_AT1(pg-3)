import math
from collections import Counter

train = """
the student is reading a book
the student is writing a program
the teacher is reading a book
the teacher is teaching computer science
the student likes computer science
"""

test = """
the student is reading a program
the teacher is reading a book
"""

train_words = train.lower().split()
test_words = test.lower().split()

unigram = Counter(train_words)
bigram = Counter()
trigram = Counter()

for i in range(len(train_words) - 1):
    bigram[(train_words[i], train_words[i + 1])] += 1

for i in range(len(train_words) - 2):
    trigram[
        (train_words[i],
         train_words[i + 1],
         train_words[i + 2])
    ] += 1


vocab = len(unigram)


def unigram_prob(word):
    return (unigram[word] + 1) / (
        len(train_words) + vocab
    )


def bigram_prob(w1, w2):
    return (bigram[(w1, w2)] + 1) / (
        unigram[w1] + vocab
    )


def trigram_prob(w1, w2, w3):
    return (trigram[(w1, w2, w3)] + 1) / (
        bigram[(w1, w2)] + vocab
    )


def calculate_entropy(n):
    total = 0

    for i, word in enumerate(test_words):

        if n == 1:
            p = unigram_prob(word)

        elif n == 2:
            if i == 0:
                p = unigram_prob(word)
            else:
                p = bigram_prob(
                    test_words[i - 1],
                    word
                )

        else:
            if i < 2:
                p = unigram_prob(word)
            else:
                p = trigram_prob(
                    test_words[i - 2],
                    test_words[i - 1],
                    word
                )

        total += -math.log2(p)

    return total / len(test_words)


print("Unigram Entropy:",
      round(calculate_entropy(1), 4))

print("Bigram Entropy:",
      round(calculate_entropy(2), 4))

print("Trigram Entropy:",
      round(calculate_entropy(3), 4))
