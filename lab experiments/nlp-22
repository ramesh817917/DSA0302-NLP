import re

text = input("Enter a text: ")

words = text.split()

last_reference = ""

for word in words:
    clean_word = re.sub(r"[.,!?]", "", word)

    if clean_word[0].isupper() and clean_word.lower() not in ["he", "she", "it"]:
        last_reference = clean_word

    if clean_word.lower() in ["he", "she", "it"]:
        print(clean_word, "refers to ->", last_reference)
